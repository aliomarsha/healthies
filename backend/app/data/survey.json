    {
      "id": "changes",
      "title": {
        "en": "Breast changes",
        "ar": "تغيّرات في الثدي"
      },
      "intro": {
        "en": "These questions help us find the right next step. There are no wrong answers.",
        "ar": "تساعدنا هذه الأسئلة على تحديد الخطوة التالية المناسبة. لا توجد إجابات خاطئة."
      },
      "questions": [
        {
          "id": "q_symptoms",
          "type": "multi",
          "group": "model_input",
          "policy_use": true,
          "model_feature": "symptom",
          "encoding": "multi_hot",
          "required": true,
          "critical": true,
          "title": {
            "en": "In the last 3 months, have you noticed any of these?",
            "ar": "خلال الأشهر الثلاثة الماضية، هل لاحظتِ أيًّا ممّا يلي؟"
          },
          "help": {
            "en": "Choose all that apply.",
            "ar": "اختاري كل ما ينطبق."
          },
          "options": [
            {
              "value": "lump",
              "concerning": true,
              "label": {
                "en": "A new lump or thickening in the breast or armpit",
                "ar": "كتلة أو سماكة جديدة في الثدي أو تحت الإبط"
              }
            },
            {
              "value": "nipple_discharge",
              "concerning": true,
              "label": {
                "en": "Fluid or blood coming from the nipple",
                "ar": "خروج سائل أو دم من الحلمة"
              }
            },
            {
              "value": "skin_change",
              "concerning": true,
              "label": {
                "en": "Skin changes such as dimpling, redness or a rash",
                "ar": "تغيّرات في الجلد مثل التنقّر أو الاحمرار أو الطفح"
              }
            },
            {
              "value": "nipple_change",
              "concerning": true,
              "label": {
                "en": "A nipple that has newly turned inward or changed shape",
                "ar": "حلمة انقلبت إلى الداخل حديثًا أو تغيّر شكلها"
              }
            },
            {
              "value": "shape_change",
              "concerning": true,
              "label": {
                "en": "A change in the size or shape of a breast",
                "ar": "تغيّر في حجم الثدي أو شكله"
              }
            },
            {
              "value": "persistent_pain",
              "concerning": true,
              "label": {
                "en": "Pain in one area that does not go away",
                "ar": "ألم في منطقة واحدة لا يزول"
              }
            },
            {
              "value": "none",
              "exclusive": true,
              "label": {
                "en": "None of these",
                "ar": "لا شيء ممّا سبق"
              }
            },
            {
              "value": "unknown",
              "exclusive": true,
              "label": {
                "en": "I'm not sure",
                "ar": "لستُ متأكدة"
              }
            }
          ]
        },
        {
          "id": "q_symptom_duration",
          "type": "single",
          "group": "action_policy",
          "required": true,
          "show_if": {
            "question": "q_symptoms",
            "any_of": [
              "lump",
              "nipple_discharge",
              "skin_change",
              "nipple_change",
              "shape_change",
              "persistent_pain"
            ]
          },
          "title": {
            "en": "Has a doctor already checked this change?",
            "ar": "هل فحص طبيب هذا التغيّر من قبل؟"
          },
          "options": [
            {
              "value": "not_checked",
              "label": {
                "en": "No, not yet",
                "ar": "لا، ليس بعد"
              }
            },
            {
              "value": "checked_waiting",
              "label": {
                "en": "Yes, and I'm waiting for tests or results",
                "ar": "نعم، وأنتظر فحوصات أو نتائج"
              }
            },
            {
              "value": "checked_done",
              "label": {
                "en": "Yes, and I was told it's fine",
                "ar": "نعم، وقيل لي إنّه لا يدعو للقلق"
              }
            },
            {
              "value": "unknown",
              "label": {
                "en": "I'm not sure",
                "ar": "لستُ متأكدة"
              }
            }
          ]
        }
      ]
    },
